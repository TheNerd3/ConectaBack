{
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": "test/db/.*\\.db-spec\\.ts$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "moduleFileExtensions": ["ts", "js", "json"],
  "globalSetup": "<rootDir>/test/db/global-setup.ts",
  "setupFiles": ["<rootDir>/test/db/setup-db-env.ts"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
