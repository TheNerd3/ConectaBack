DATABASE_URL="postgresql://conecta:conecta@localhost:5432/conecta?schema=public"
PORT=3000
FRONT_URL=http://localhost:5173
# URL pública de la API (se usa para las redirect URI de OAuth)
API_PUBLIC_URL=http://localhost:3000/api

# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Duración del access token (ej.: 1h, 15m)
JWT_EXPIRES_IN=1h

# Clave de 32 bytes (base64 o hex) para cifrar secretos en la DB
# (User.totpSecretEncrypted, Integration.encryptedToken). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Cuenta de administración creada por `npm run db:seed` (no se registra por la API)
ADMIN_EMAIL=admin@conecta.local
# Mínimo 12 caracteres
ADMIN_PASSWORD=

# Emails (recuperar contraseña). En desarrollo: Mailpit (npm run mail:up), bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Conecta <no-reply@conecta.local>"

# Login con Google / GitHub (opcional: si faltan, el botón muestra "no disponible"). Ver README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
