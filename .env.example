DATABASE_URL="postgresql://conecta:conecta@localhost:5432/conecta?schema=public"
PORT=3000
FRONT_URL=http://localhost:5173

# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Duración del access token (ej.: 1h, 15m)
JWT_EXPIRES_IN=1h

# Clave de 32 bytes (base64 o hex) para cifrar secretos en la DB
# (User.totpSecretEncrypted, Integration.encryptedToken). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Cuenta de administración creada por `npm run db:seed` (no se registra por la API)
ADMIN_EMAIL=admin@conecta.local
# Mínimo 12 caracteres
ADMIN_PASSWORD=
